# ============================================================
# Sentinel environment configuration
# ============================================================
# Copy this file to `.env` for local development:
#
#   cp .env.example .env
#
# Never commit the real `.env` file.


# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------

# Host running the Sentinel monitoring database.
POSTGRES_HOST=localhost

# Sentinel database name.
POSTGRES_DB=sentinel

# PostgreSQL user.
POSTGRES_USER=sentinel

# Replace this value in your local .env.
POSTGRES_PASSWORD=change-me

# Sentinel currently defaults to port 5433.
POSTGRES_PORT=5433


# ------------------------------------------------------------
# Apache Kafka
# ------------------------------------------------------------

# Kafka broker used by the Sentinel producer and consumer.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Topic carrying FHIR Observation events.
KAFKA_TOPIC=fhir-observations

# Consumer group used by the live Sentinel monitor.
KAFKA_CONSUMER_GROUP=sentinel-live-monitor

# Where a new consumer should begin reading when no offset exists.
KAFKA_AUTO_OFFSET_RESET=latest


# ------------------------------------------------------------
# Synthea / Replay
# ------------------------------------------------------------

# Path to the local Synthea JAR.
# Example:
# SYNTHEA_JAR=/absolute/path/to/synthea-with-dependencies.jar
SYNTHEA_JAR=

# Replay throughput in records/events per second.
REPLAY_RATE=50.0

# Number of synthetic patients to generate when using Synthea.
SYNTHEA_POPULATION=200


# ------------------------------------------------------------
# Dashboard
# ------------------------------------------------------------

# Optional IANA timezone used when displaying timestamps.
#
# Examples:
#   UTC
#   Asia/Riyadh
#   Europe/London
#
# Leave blank to use Sentinel's default behavior.
SENTINEL_DISPLAY_TZ=


# ------------------------------------------------------------
# Data / Google Cloud
# ------------------------------------------------------------

# Google Cloud project containing the Sentinel data bucket.
GCP_PROJECT_ID=your-gcp-project-id

# Google Cloud Storage bucket used for Sentinel data.
GCS_BUCKET=your-sentinel-bucket

# Location of the healthy Observation Silver dataset used for
# baseline and numeric-drift experiments.
#
# Example:
# SENTINEL_SILVER_PATH=gs://your-bucket/silver/observations/run_id=001/observations.parquet
SENTINEL_SILVER_PATH=
